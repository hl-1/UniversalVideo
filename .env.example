MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=videodream
MYSQL_USER=videodream_local
MYSQL_PASSWORD=replace-with-your-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600
REDIS_DATABASE=0

# Generate locally with scripts/initialize-accounts.py; never commit the real key.
VIDEODREAM_JWT_SECRET=
VIDEODREAM_COOKIE_SECURE=false
VIDEODREAM_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# 文字总结与思维导图（修改后重启后端）
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# 截图识别（独立服务地址、模型和密钥）
LLM_VISION_BASE_URL=https://api.openai.com/v1
LLM_VISION_MODEL=
LLM_VISION_API_KEY=

# 语音转写（服务需支持 /audio/transcriptions）
LLM_ASR_BASE_URL=https://api.siliconflow.cn/v1
LLM_ASR_MODEL=
LLM_ASR_API_KEY=
