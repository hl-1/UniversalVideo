MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=videodream
MYSQL_USER=videodream_local
MYSQL_PASSWORD=replace-with-your-password

# Optional separate DDL account used only by scripts/database.py.
# Omit both values to use MYSQL_USER / MYSQL_PASSWORD during initial setup.
VIDEODREAM_MIGRATION_USER=
VIDEODREAM_MIGRATION_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600
REDIS_DATABASE=0

# Generate locally with scripts/initialize-accounts.py; never commit the real key.
VIDEODREAM_JWT_SECRET=
VIDEODREAM_COOKIE_SECURE=false
VIDEODREAM_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# YouTube / Pornhub：全部功能仅限超级管理员；修改后重启后端。
VIDEODREAM_OVERSEAS_ENABLED=true
VIDEODREAM_OVERSEAS_PROXY_URL=http://127.0.0.1:7890
VIDEODREAM_OVERSEAS_ROUTE_REVISION=1

# 文字总结与思维导图（修改后重启后端）
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# 截图识别（独立服务地址、模型和密钥）
LLM_VISION_BASE_URL=https://api.openai.com/v1
LLM_VISION_MODEL=
LLM_VISION_API_KEY=

# 语音转写（服务需支持 /audio/transcriptions）
LLM_ASR_BASE_URL=https://api.siliconflow.cn/v1
LLM_ASR_MODEL=
LLM_ASR_API_KEY=


# Optional LiveKit audio service. Keep server credentials private.
# Without these values, recorded duets work and room voice is unavailable.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VIDEODREAM_USER_ID_WORKER=0
# Configure LiveKit's signed webhook to https://YOUR_HOST/api/social/rtc-webhook.
# Enable realtime duets only after device/network validation in admin settings.

# Agent task center / LangGraph. Rollback: legacy plus AGENT_ENABLED=false.
VIDEODREAM_AGENT_ENGINE=langgraph
VIDEODREAM_AGENT_ENABLED=true
VIDEODREAM_AGENT_CONCURRENCY=2
VIDEODREAM_AGENT_DAILY_TOKENS=1000000
# Optional JSON keyed by model: input_per_million, output_per_million, currency, version.
# Unknown cost stays null until actual provider prices are configured.
VIDEODREAM_AGENT_PRICING={}
# Shape example (replace rates): {"model":{"input_per_million":"0","output_per_million":"0","currency":"CNY","version":"YYYY-MM-DD"}}

# Embeddings use a dedicated model; the provider account/key may be reused.
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_MODEL=BAAI/bge-m3
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_DIMENSIONS=1024
# Optional rerank; disabled per query by default.
LLM_RERANK_BASE_URL=https://api.siliconflow.cn/v1
LLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LLM_RERANK_API_KEY=
VIDEODREAM_ES_URL=
VIDEODREAM_ES_USER=
VIDEODREAM_ES_PASSWORD=
VIDEODREAM_RAG_INDEX=videodream_rag_chunks_v1
VIDEODREAM_RAG_ANALYZER=ik_max_word
VIDEODREAM_MINIO_ENDPOINT=
VIDEODREAM_MINIO_ACCESS_KEY=
VIDEODREAM_MINIO_SECRET_KEY=
VIDEODREAM_MINIO_BUCKET=videodream
