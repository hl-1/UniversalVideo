# Build the app image first: docker compose -f deploy/compose.yml build app
# Java and Flyway are added only to this one-shot migration image.
ARG JAVA_IMAGE=eclipse-temurin:21-jre-jammy@sha256:affcab5356e1270ac35d2361ee83135af2f03e8d580eca78a6d5d6fdbf048db0
FROM ${JAVA_IMAGE} AS java
FROM videodream:local

USER root
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:$PATH \
    VIDEODREAM_FLYWAY_EXE=/flyway/flyway
RUN python scripts/setup-flyway.py \
    && mv /app/.run/tools/flyway-13.11.1 /flyway \
    && chmod -R a+rX /flyway /opt/java/openjdk
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--", "python", "scripts/database.py"]
CMD ["migrate"]
