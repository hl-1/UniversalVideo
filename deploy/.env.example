# Copy to deploy/.env.production on your computer, fill it in, then upload separately.
# This file is mounted at /app/.env.universal-video.local, NOT used as Compose env_file.
# Use UTF-8 dotenv syntax; values containing spaces or # should be quoted.

MYSQL_HOST=code-generator-mysql-1
MYSQL_PORT=3306
MYSQL_DATABASE=videodream
MYSQL_USER=videodream_app
MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Optional migration account; the application account may use DML-only grants.
VIDEODREAM_MIGRATION_USER=
VIDEODREAM_MIGRATION_PASSWORD=

REDIS_HOST=code-generator-redis-1
REDIS_PORT=6379
REDIS_PASSWORD=
# Reserve db1 after checking both existing applications' configuration.
REDIS_DATABASE=1
REDIS_TTL=3600

# Generate ONCE with: openssl rand -hex 48
# Set before initializing admin: the mounted file is read-only in the container.
VIDEODREAM_JWT_SECRET=REPLACE_WITH_96_HEX_CHARACTERS
VIDEODREAM_COOKIE_SECURE=true
VIDEODREAM_ORIGINS=https://xianyue.huanliyu.cn

# Text summaries and mind maps: independent DeepSeek endpoint, model and key.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Screenshot recognition: independent SiliconFlow endpoint, model and key.
# Keep all three fields explicit; do not reference the text group's variables.
LLM_VISION_BASE_URL=https://api.siliconflow.cn/v1
LLM_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_VISION_API_KEY=

# Speech transcription: independent SiliconFlow endpoint, model and key.
# Keep all three fields explicit; provider must support /audio/transcriptions.
LLM_ASR_BASE_URL=https://api.siliconflow.cn/v1
LLM_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
LLM_ASR_API_KEY=
