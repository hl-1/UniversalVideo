# Dockerfile-specific ignore file, applied to the repository-root build context.
# Only application sources and build inputs are sent to the builder.
**
!backend/
!backend/**
!frontend/
!frontend/**
!scripts/
!scripts/**
!deploy/
!deploy/Dockerfile
!deploy/Dockerfile.dockerignore

**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/node_modules/
**/dist/
**/.vite/
**/*.tsbuildinfo
**/.DS_Store
**/.env
**/.env.*
**/*.key
**/*.crt
**/*.pem
**/*.p12
**/*.pfx
**/*.zip
